# Copy to zitadel/.env.dev (gitignored, never commit it) and fill in.
# Values here are placeholders, not credentials.

# Postgres superuser. Must match ADMIN_USERNAME in docker-compose.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME-dev-postgres-superuser

# Zitadel database role (created by start-from-init via the superuser).
ZITADEL_DATABASE_POSTGRES_USER_PASSWORD=CHANGEME-dev-zitadel-db-user

# Admin connection for init (must be the superuser above).
ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD=CHANGEME-dev-postgres-superuser

# Masterkey for en/decryption keys. Must be exactly 32 characters
# (count them after editing; Zitadel refuses anything else).
ZITADEL_MASTERKEY=CHANGEME-32-char-dev-masterkey!!

# First-instance human admin login (applies on first init only).
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=CHANGEME-dev-admin-password

# Login UI session-cookie secret (the login container reads it every
# start). At least 32 characters; generate with `openssl rand -base64 32`.
# Dev-only: never reuse this value anywhere real.
ZITADEL_LOGIN_SESSION_COOKIE_SECRET=CHANGEME-32-char-dev-login-cookie!!
